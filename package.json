{
  "name": "khalwa-school-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --project demo-khalwa --only firestore \"vitest run tests/rules.test.ts\"",
    "dev:cloud": "firebase emulators:exec --project demo-khalwa --only firestore,auth \"VITE_EMULATOR=1 vite\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "firebase-tools": "^13.35.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
